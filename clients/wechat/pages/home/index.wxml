<web-view wx:if="{{url && !failed}}" src="{{url}}" binderror="onFailure"></web-view>
<view wx:else class="state">
  <text class="title">{{failed ? words.offline : words.missing}}</text>
  <text>{{failed ? words.offlineHint : words.missingHint}}</text>
  <button wx:if="{{failed}}" bindtap="reconnect">{{words.retry}}</button>
</view>
