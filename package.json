{
  "name": "nursing-home",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter @nh/api --filter @nh/admin --filter @nh/family run dev",
    "dev:api": "pnpm --filter @nh/api dev",
    "dev:admin": "pnpm --filter @nh/admin dev",
    "dev:family": "pnpm --filter @nh/family dev",
    "dev:desktop": "pnpm --filter @nh/desktop dev",
    "dev:agent": "cd apps/agent && (test -d .venv || python3 -m venv .venv) && .venv/bin/pip install -q -r requirements.txt && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8100",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @nh/api prisma:generate",
    "db:push": "pnpm --filter @nh/api prisma:push",
    "db:seed": "pnpm --filter @nh/api prisma:seed",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
