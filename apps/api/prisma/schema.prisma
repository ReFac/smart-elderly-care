generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings      Building[]
  employees      Employee[]
  elders         Elder[]
  featureFlags   FeatureFlag[]
  feeItems       FeeItem[]
  priceRules     PriceRule[]
  mealMenus      MealMenu[]
  systemAiConfig SystemAiConfig?
  alerts         Alert[]
  inventoryItems InventoryItem[]
  shifts         Shift[]
  drugs          Drug[]
  ltcServiceItems LtcServiceItem[]
  reportSubmissions ReportSubmission[]
  accessLogs     AccessLog[]
  maintenanceOrders MaintenanceOrder[]
  systemVariables SystemVariable[]
  serviceRegistries ServiceRegistry[]
  apiEndpoints   ApiEndpointMeta[]
  roomTours      RoomTour[]
  acousticDevices AcousticDevice[]
  acousticEvents AcousticEvent[]
  clinicalFindings ClinicalFinding[]
  prediagnosisReports PrediagnosisReport[]
  clinicalPushes ClinicalPush[]
  promptTemplates PromptTemplate[]
  acousticConfigs AcousticSensitivityConfig[]
}

model Building {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  address  String?
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  floors   Floor[]

  @@unique([tenantId, code])
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  name       String
  level      Int
  planImage  String?
  building   Building @relation(fields: [buildingId], references: [id])
  rooms      Room[]
}

model Room {
  id       String @id @default(cuid())
  floorId  String
  number   String
  capacity Int    @default(2)
  floor    Floor  @relation(fields: [floorId], references: [id])
  beds     Bed[]
}

model Bed {
  id     String @id @default(cuid())
  roomId String
  code   String
  status String @default("idle")
  room   Room   @relation(fields: [roomId], references: [id])
  elder  Elder?

  @@unique([roomId, code])
}

model Employee {
  id           String   @id @default(cuid())
  tenantId     String
  username     String
  passwordHash String
  name         String
  phone        String?
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  careCheckins   CareCheckin[]   @relation("CaregiverCheckins")
  assignedOrders ServiceOrder[]  @relation("AssignedOrders")
  createdOrders  ServiceOrder[]  @relation("CreatedOrders")
  familyBindings FamilyBinding[]
  shifts         Shift[]
  attendances    Attendance[]
  performances   PerformanceRecord[]
  medicationDoses MedicationDose[]

  @@unique([tenantId, username])
}

model Elder {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  gender          String    @default("unknown")
  idNumber        String?
  birthDate       DateTime?
  phone           String?
  admitSource     String?
  paymentType     String    @default("self")
  careLevel       String    @default("independent")
  bedId           String?   @unique
  checkInDate     DateTime?
  checkOutDate    DateTime?
  depositAmount   Float     @default(0)
  wanderRisk      Boolean   @default(false)
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  bed            Bed?            @relation(fields: [bedId], references: [id])
  health         ElderHealth?
  contacts       ElderContact[]
  contracts      Contract[]
  bedChangeLogs  BedChangeLog[]
  carePlans      CarePlan[]
  careTasks      CareTask[]
  serviceOrders  ServiceOrder[]
  visitRecords   VisitRecord[]
  emotionRecords EmotionRecord[]
  bills          Bill[]
  deposits       Deposit[]
  waivers        Waiver[]
  mealRestrictions MealRestriction[]
  familyBindings FamilyBinding[]
  attachments    Attachment[]
  deviceLocations DeviceLocation[]
  vitalSigns     VitalSign[]
  medicationPlans MedicationPlan[]
  adverseReactions AdverseReaction[]
  healthExams    HealthExam[]
  chronicFollowUps ChronicFollowUp[]
  medicalOrders  MedicalOrder[]
  referralRecords ReferralRecord[]
  ltcAssessments LtcAssessment[]
  ltcServiceRecords LtcServiceRecord[]
  ltcReconciliations LtcReconciliation[]
  acousticEvents AcousticEvent[]
  clinicalFindings ClinicalFinding[]
  prediagnosisReports PrediagnosisReport[]
  clinicalPushes ClinicalPush[]
}

model ElderHealth {
  id              String  @id @default(cuid())
  elderId         String  @unique
  medicalHistory  String?
  allergies       String?
  chronicDiseases String?
  forbiddenDrugs  String?
  dietTaboos      String?
  assessmentNote  String?
  /// 声学/病理性特征摘要（JSON 或短文本，由 clinical-intel 自动维护）
  clinicalNotes   String?
  acousticRiskTags String?
  elder           Elder   @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model ElderContact {
  id           String  @id @default(cuid())
  elderId      String
  name         String
  relation     String?
  phone        String
  isEmergency  Boolean @default(false)
  isPrimary    Boolean @default(false)
  elder        Elder   @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model FamilyBinding {
  id         String   @id @default(cuid())
  employeeId String
  elderId    String
  relation   String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  elder      Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)

  @@unique([employeeId, elderId])
}

model Contract {
  id        String    @id @default(cuid())
  elderId   String
  type      String
  title     String
  fileUrl   String?
  startDate DateTime?
  endDate   DateTime?
  reminded  Boolean   @default(false)
  createdAt DateTime  @default(now())
  elder     Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model BedChangeLog {
  id         String   @id @default(cuid())
  elderId    String
  fromBedId  String?
  toBedId    String?
  reason     String?
  operatedBy String?
  createdAt  DateTime @default(now())
  elder      Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model CarePlan {
  id        String   @id @default(cuid())
  elderId   String
  careLevel String
  itemsJson String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  elder     Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
  tasks     CareTask[]
}

model CareTask {
  id          String    @id @default(cuid())
  elderId     String
  carePlanId  String?
  title       String
  scheduledAt DateTime
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  elder       Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)
  carePlan    CarePlan? @relation(fields: [carePlanId], references: [id])
  checkins    CareCheckin[]
}

model CareCheckin {
  id          String   @id @default(cuid())
  careTaskId  String
  caregiverId String
  checkedAt   DateTime @default(now())
  photoUrl    String?
  note        String?
  anomaly     String?
  careTask    CareTask @relation(fields: [careTaskId], references: [id], onDelete: Cascade)
  caregiver   Employee @relation("CaregiverCheckins", fields: [caregiverId], references: [id])
}

model ServiceOrder {
  id           String    @id @default(cuid())
  elderId      String
  title        String
  description  String?
  status       String    @default("pending")
  createdById  String
  assigneeId   String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  elder        Elder     @relation(fields: [elderId], references: [id], onDelete: Cascade)
  createdBy    Employee  @relation("CreatedOrders", fields: [createdById], references: [id])
  assignee     Employee? @relation("AssignedOrders", fields: [assigneeId], references: [id])
}

model VisitRecord {
  id          String   @id @default(cuid())
  elderId     String
  visitorName String
  relation    String?
  phone       String?
  visitAt     DateTime @default(now())
  leaveAt     DateTime?
  note        String?
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model EmotionRecord {
  id        String   @id @default(cuid())
  elderId   String
  mood      String
  behavior  String?
  note      String?
  recordedAt DateTime @default(now())
  elder     Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model FeeItem {
  id          String  @id @default(cuid())
  tenantId    String
  code        String
  name        String
  unit        String  @default("月")
  defaultPrice Float  @default(0)
  category    String  @default("other")
  active      Boolean @default(true)
  tenant      Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model PriceRule {
  id         String  @id @default(cuid())
  tenantId   String
  careLevel  String
  feeItemCode String
  price      Float
  billingCycle String @default("monthly")
  tenant     Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, careLevel, feeItemCode])
}

model Bill {
  id          String   @id @default(cuid())
  elderId     String
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Float    @default(0)
  paidAmount  Float    @default(0)
  status      String   @default("unpaid")
  remark      String?
  createdAt   DateTime @default(now())
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
  lines       BillLine[]
  payments    Payment[]
}

model BillLine {
  id        String @id @default(cuid())
  billId    String
  feeCode   String
  feeName   String
  quantity  Float  @default(1)
  unitPrice Float
  amount    Float
  bill      Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  billId    String
  amount    Float
  method    String   @default("cash")
  paidAt    DateTime @default(now())
  remark    String?
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Deposit {
  id        String   @id @default(cuid())
  elderId   String
  amount    Float
  type      String   @default("in")
  remark    String?
  createdAt DateTime @default(now())
  elder     Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model Waiver {
  id        String   @id @default(cuid())
  elderId   String
  amount    Float
  reason    String?
  createdAt DateTime @default(now())
  elder     Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model MealMenu {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime
  mealType  String
  dishes    String
  dietTags  String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date, mealType])
}

model MealRestriction {
  id      String @id @default(cuid())
  elderId String
  tags    String
  note    String?
  elder   Elder  @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id @default(cuid())
  elderId   String?
  category  String   @default("general")
  fileName  String
  fileUrl   String
  mimeType  String?
  createdAt DateTime @default(now())
  elder     Elder?   @relation(fields: [elderId], references: [id])
}

model FeatureFlag {
  id       String  @id @default(cuid())
  tenantId String
  key      String
  enabled  Boolean @default(false)
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

model SystemAiConfig {
  id           String  @id @default(cuid())
  tenantId     String  @unique
  provider     String  @default("openai_compatible")
  baseUrl      String  @default("https://api.openai.com/v1")
  apiKey       String  @default("")
  model        String  @default("gpt-4o-mini")
  ocrProvider  String  @default("mock")
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
}

model Alert {
  id         String   @id @default(cuid())
  tenantId   String
  type       String
  title      String
  message    String?
  elderId    String?
  source     String   @default("system")
  severity   String   @default("medium")
  status     String   @default("open")
  handledBy  String?
  handledAt  DateTime?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model InventoryItem {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  sku       String?
  category  String @default("consumable")
  quantity  Float  @default(0)
  unit      String @default("件")
  lowStock  Float  @default(10)
  expireAt  DateTime?
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  stockLogs InventoryStockLog[]
}

model InventoryStockLog {
  id        String   @id @default(cuid())
  itemId    String
  type      String
  quantity  Float
  remark    String?
  createdAt DateTime @default(now())
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model MaintenanceOrder {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  location    String?
  description String?
  status      String    @default("pending")
  assignee    String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
}

model Shift {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  shiftDate  DateTime
  shiftType  String
  floorId    String?
  elderIds   String?
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  checkInAt  DateTime @default(now())
  checkOutAt DateTime?
  note       String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PerformanceRecord {
  id           String   @id @default(cuid())
  employeeId   String
  period       String
  taskCount    Int      @default(0)
  doneCount    Int      @default(0)
  score        Float    @default(0)
  bonusAmount  Float    @default(0)
  remark       String?
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model DeviceLocation {
  id         String   @id @default(cuid())
  elderId    String
  deviceId   String
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())
  elder      Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model AccessLog {
  id        String   @id @default(cuid())
  tenantId  String
  person    String
  direction String
  gate      String?
  relatedElderId String?
  recordedAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model VitalSign {
  id         String   @id @default(cuid())
  elderId    String
  recordedAt DateTime @default(now())
  systolic   Float?
  diastolic  Float?
  glucose    Float?
  temperature Float?
  spo2       Float?
  pulse      Float?
  note       String?
  elder      Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model Drug {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  spec         String?
  unit         String   @default("盒")
  quantity     Float    @default(0)
  lowStock     Float    @default(5)
  expireAt     DateTime?
  isHighRisk   Boolean  @default(false)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  stockLogs    DrugStockLog[]
  plans        MedicationPlan[]
}

model DrugStockLog {
  id        String   @id @default(cuid())
  drugId    String
  type      String
  quantity  Float
  remark    String?
  createdAt DateTime @default(now())
  drug      Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
}

model MedicationPlan {
  id        String   @id @default(cuid())
  elderId   String
  drugId    String
  dosage    String
  schedule  String
  startDate DateTime?
  endDate   DateTime?
  active    Boolean  @default(true)
  note      String?
  elder     Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
  drug      Drug     @relation(fields: [drugId], references: [id])
  doses     MedicationDose[]
}

model MedicationDose {
  id        String   @id @default(cuid())
  planId    String
  nurseId   String?
  scheduledAt DateTime
  givenAt   DateTime?
  status    String   @default("pending")
  missedReason String?
  note      String?
  plan      MedicationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  nurse     Employee? @relation(fields: [nurseId], references: [id])
}

model AdverseReaction {
  id          String   @id @default(cuid())
  elderId     String
  drugName    String
  reaction    String
  severity    String   @default("mild")
  recordedAt  DateTime @default(now())
  note        String?
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model HealthExam {
  id          String   @id @default(cuid())
  elderId     String
  examDate    DateTime
  examType    String   @default("regular")
  summary     String?
  reportUrl   String?
  nextDueAt   DateTime?
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model ChronicFollowUp {
  id          String   @id @default(cuid())
  elderId     String
  disease     String
  followDate  DateTime
  result      String?
  nextDate    DateTime?
  note        String?
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model MedicalOrder {
  id          String   @id @default(cuid())
  elderId     String
  source      String   @default("clinic")
  content     String
  orderedAt   DateTime @default(now())
  status      String   @default("active")
  doctorName  String?
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model ReferralRecord {
  id            String   @id @default(cuid())
  elderId       String
  hospital      String?
  reason        String?
  departAt      DateTime?
  returnAt      DateTime?
  escort        String?
  ambulance120  Boolean  @default(false)
  handoverNote  String?
  elder         Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model LtcAssessment {
  id            String   @id @default(cuid())
  elderId       String
  level         String
  assessDate    DateTime
  assessor      String?
  resultSummary String?
  fileUrl       String?
  status        String   @default("draft")
  elder         Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model LtcServiceItem {
  id          String @id @default(cuid())
  tenantId    String
  code        String
  name        String
  unitPrice   Float  @default(0)
  unit        String @default("次")
  active      Boolean @default(true)
  tenant      Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model LtcServiceRecord {
  id          String   @id @default(cuid())
  elderId     String
  itemCode    String
  itemName    String
  quantity    Float    @default(1)
  amount      Float    @default(0)
  serviceAt   DateTime @default(now())
  caregiver   String?
  evidenceUrl String?
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model LtcReconciliation {
  id          String   @id @default(cuid())
  elderId     String
  period      String
  claimAmount Float    @default(0)
  approvedAmount Float @default(0)
  status      String   @default("pending")
  exportUrl   String?
  remark      String?
  createdAt   DateTime @default(now())
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

model ReportSubmission {
  id          String   @id @default(cuid())
  tenantId    String
  reportType  String
  period      String
  status      String   @default("draft")
  payloadJson String?
  fileUrl     String?
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

/// 主控台可改运行变量（敏捷配置，非改代码）
model SystemVariable {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       String
  valueType   String   @default("string")
  groupName   String   @default("general")
  description String?
  editable    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

/// 可启停的后端/外部服务注册
model ServiceRegistry {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  baseUrl     String?
  status      String   @default("up")
  enabled     Boolean  @default(true)
  healthPath  String?
  metaJson    String?
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

/// API 元数据：启停、文档、扩展点
model ApiEndpointMeta {
  id          String   @id @default(cuid())
  tenantId    String
  method      String
  path        String
  module      String
  audience    String   @default("admin")
  enabled     Boolean  @default(true)
  description String?
  version     String   @default("v1")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, method, path])
}

/// 3D / 全景房态导览
model RoomTour {
  id          String   @id @default(cuid())
  tenantId    String
  buildingId  String?
  floorId     String?
  roomId      String?
  title       String
  coverUrl    String?
  sceneType   String   @default("panorama")
  sceneUrl    String?
  modelUrl    String?
  yaw         Float    @default(0)
  pitch       Float    @default(0)
  fov         Float    @default(75)
  published   Boolean  @default(false)
  metaJson    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  hotspots    RoomTourHotspot[]
}

model RoomTourHotspot {
  id          String   @id @default(cuid())
  tourId      String
  label       String
  kind        String   @default("info")
  yaw         Float    @default(0)
  pitch       Float    @default(0)
  targetTourId String?
  payloadJson String?
  tour        RoomTour @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

/// 床头麦克风 / 声学设备（可选择接入）
model AcousticDevice {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  bedId     String?
  elderId   String?
  vendor    String   @default("generic")
  enabled   Boolean  @default(true)
  metaJson  String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

/// 声学事件：咳嗽、碰撞异响等（原始/模型输出入库）
model AcousticEvent {
  id            String   @id @default(cuid())
  tenantId      String
  elderId       String?
  deviceId      String?
  bedId         String?
  eventType     String   // cough | impact | speech | unknown
  subtype       String?  // paroxysmal_cough | mild_cough | hard_impact | soft_impact
  confidence    Float    @default(0)
  severity      String   @default("low") // low | medium | high | critical
  pathological  Boolean  @default(false)
  contextScore  Float?   // 结合历史上下文后的评分
  modelId       String?  // 推理模型标识，便于 SOTA 替换
  modelVersion  String?
  rawJson       String?  // 原始特征/波形元数据（不含音频二进制时可存 URI）
  audioUri      String?
  decidedBy     String   @default("stub") // stub | sota | human
  status        String   @default("pending") // pending | accepted | rejected | noise
  note          String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  elder         Elder?   @relation(fields: [elderId], references: [id])
}

/// 识别出的病理性特征 → 写入老人档案的结构化条目
model ClinicalFinding {
  id          String   @id @default(cuid())
  tenantId    String
  elderId     String
  eventId     String?
  category    String   // respiratory | trauma_risk | fall_risk | other
  code        String?  // 可映射 ICD/内部编码
  title       String
  detail      String?
  evidenceJson String?
  source      String   @default("acoustic")
  confidence  Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

/// AI 预诊报告（一键生成，可人工复核）
model PrediagnosisReport {
  id            String   @id @default(cuid())
  tenantId      String
  elderId       String
  promptKey     String   @default("clinical.prediagnosis.v1")
  status        String   @default("draft") // draft | reviewed | archived
  situation     String?  // 老人相关情况详述
  medicalAdvice String?  // 医学性建议（非诊断结论）
  riskHints     String?  // 风险提示
  inferenceJson String?  // 可能性医疗推断结构
  modelId       String?
  modelVersion  String?
  generatedBy   String   @default("system")
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  elder         Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

/// 推送：默认院内；护工确认后才可推家属
model ClinicalPush {
  id          String   @id @default(cuid())
  tenantId    String
  elderId     String
  reportId    String?
  eventId     String?
  audience    String   // facility | family
  channel     String   @default("in_app") // in_app | sms | wechat | wecom
  title       String
  body        String
  status      String   @default("queued") // queued | sent | blocked | approved | rejected
  approvedBy  String?
  approvedAt  DateTime?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  elder       Elder    @relation(fields: [elderId], references: [id], onDelete: Cascade)
}

/// 系统提示词（医学建议 / 风险提示等，可后台改）
model PromptTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  title       String
  content     String
  version     String   @default("v1")
  locale      String   @default("zh-CN")
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key, version])
}

/// 识别敏捷度 / 灵敏度（后台可调，模型侧读取）
model AcousticSensitivityConfig {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String   @default("default")
  /// 0~1 咳嗽检出灵敏度（越高越敏感，误报可能↑）
  coughSensitivity   Float    @default(0.55)
  /// 急促型咳嗽判定窗口（秒）
  paroxysmalWindowSec Float   @default(8)
  /// 急促型最少咳嗽次数
  paroxysmalMinCount Int      @default(3)
  /// 硬碰撞阈值（软碰撞默认忽略）
  hardImpactThreshold Float   @default(0.72)
  softImpactIgnore   Boolean  @default(true)
  /// 上下文加权：近期同类事件抬升分
  contextBoost       Float    @default(0.15)
  /// 是否自动写档案
  autoUpdateProfile  Boolean  @default(true)
  /// 是否自动生成院内推送（家属仍需人工确认）
  autoFacilityPush   Boolean  @default(true)
  /// 外部 SOTA 推理服务 URL（空则用 stub）
  inferenceBaseUrl   String?
  inferenceApiKey    String?
  modelId            String   @default("stub-acoustic-v0")
  enabled            Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
  tenant             Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}
